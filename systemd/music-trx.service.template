[Unit]
Description=Music TRX Audio Network Transceiver (JACK)
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=%USERNAME%
Group=audio
LimitRTPRIO=95
LimitMEMLOCK=infinity

# JACK headless: non tentare la reservation D-Bus del device audio
Environment=JACK_NO_AUDIO_RESERVATION=1

# Imposta la CPU su performance come root (+) prima di avviare lo script
ExecStartPre=+/bin/sh -c 'echo performance | tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor > /dev/null'
ExecStart=/usr/local/bin/start-music-trx.sh

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
